# Imagem do backend (Gunicorn), do worker e do beat do Celery.
# Contexto de build: raiz do repositório.

# --- Estágio de build ---------------------------------------------------------
# O git existe só aqui: a freedfe é instalada por commit (o repositório dela não
# publica tags). Ele não vai para a imagem final.
FROM python:3.14-slim AS build

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /tmp/requirements.txt
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install -r /tmp/requirements.txt

# --- Imagem final -------------------------------------------------------------
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

COPY --from=build /opt/venv /opt/venv

# Ferramentas do backup (ADR 0008): pg_dump/pg_restore da série 18, igual ao servidor (repositório
# oficial do PostgreSQL, PGDG), e o age, que cifra o backup para a chave pública configurada.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
        https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && . /etc/os-release \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-18 age \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*

# Layout: /app/VERSION e /app/backend (o settings lê ../VERSION).
WORKDIR /app

COPY VERSION VERSION
COPY backend backend
COPY docker/entrypoint-backend.sh /usr/local/bin/entrypoint-backend.sh

# Execução sem privilégios de root.
# A pasta dos ZIPs do download em lote existe na imagem, com o dono certo: um volume nomeado
# montado nela herda esse dono na primeira vez (backend e worker o compartilham).
RUN useradd --system --uid 10001 --no-create-home freenfse \
    && chmod 0755 /usr/local/bin/entrypoint-backend.sh \
    && mkdir -p /var/lib/freenfse/exportacoes /var/lib/freenfse/backups \
    && chown freenfse /var/lib/freenfse/exportacoes /var/lib/freenfse/backups \
    && chmod 0700 /var/lib/freenfse/backups
USER freenfse

WORKDIR /app/backend
EXPOSE 8000

ENTRYPOINT ["entrypoint-backend.sh"]
# --no-control-socket: o socket de controle do Gunicorn 26 grava em $HOME, que
# não existe para o usuário de sistema, e não é usado aqui.
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--access-logfile", "-", "--no-control-socket"]
