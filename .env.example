# ============================================================================
# Configuração do freenfse por variáveis de ambiente.
#
# Uso:  cp .env.example .env   (e preencha os valores em branco)
# O arquivo .env NUNCA deve ser versionado (está no .gitignore): o repositório
# é público. Este arquivo traz só valores fictícios ou vazios.
# ============================================================================

# Chave secreta do Django (assina sessões e tokens). Obrigatória; sem ela a
# aplicação não sobe. Gere uma exclusiva por instalação:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Modo de depuração do Django. Mantenha false fora do desenvolvimento.
DEBUG=false

# Hosts aceitos pela aplicação, separados por vírgula. Acrescente o domínio
# público da instalação; mantenha localhost e 127.0.0.1 (usados no healthcheck).
ALLOWED_HOSTS=localhost,127.0.0.1

# Nível de log da aplicação: DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=INFO

# --- PostgreSQL ---------------------------------------------------------------
# Nome do banco e usuário. No Docker Compose o banco é criado com estes valores.
POSTGRES_DB=freenfse
POSTGRES_USER=freenfse
# Senha do banco. Obrigatória; gere uma exclusiva por instalação:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
# Endereço do PostgreSQL. No Docker Compose é ajustado automaticamente para o
# serviço "postgres"; para rodar fora do Docker, use localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (fila do Celery e contadores de segurança) ---------------------------
# No Docker Compose é ajustado automaticamente para o serviço "redis".
REDIS_URL=redis://localhost:6379/0
# Cache do Django (contadores do bloqueio por tentativas de login). Padrão: o
# mesmo Redis, banco 1. Precisa ser compartilhado entre os processos da API.
# REDIS_CACHE_URL=redis://localhost:6379/1

# --- Publicação (Docker Compose) --------------------------------------------------
# Porta do host em que o Nginx responde.
HTTP_PORT=8080

# PostgreSQL e Redis são publicados no host só em 127.0.0.1 (para desenvolvimento,
# com o backend rodando fora do Docker). Dentro do Compose os serviços usam sempre
# a porta interna (5432 / 6379), então alterar estas portas não afeta a aplicação.
# Para expor em outra interface, descomente e use 0.0.0.0 (proteja com firewall).
# POSTGRES_BIND=127.0.0.1
# REDIS_BIND=127.0.0.1
# REDIS_PORT=6379

# --- Recursos (Docker Compose; opcionais) ---------------------------------------------
# Tetos de memória por contêiner. Os padrões abaixo são iniciais (aplicação vazia)
# e devem ser recalibrados com carga real. Ultrapassar o teto encerra o processo.
# MEM_LIMIT_POSTGRES=512m
# MEM_LIMIT_REDIS=64m
# MEM_LIMIT_BACKEND=512m
# MEM_LIMIT_WORKER=512m
# MEM_LIMIT_BEAT=192m
# MEM_LIMIT_NGINX=32m
# Processos do Gunicorn (API) e do worker do Celery. Ajuste à RAM e aos núcleos do host.
# GUNICORN_WORKERS=2
# CELERY_CONCURRENCY=2

# --- Criptografia de dados sensíveis --------------------------------------------
# Chaves AES-256-GCM para os campos criptografados (certificado A1, senhas, tokens).
# Formato: "<versão>:<chave>", separadas por vírgula; a PRIMEIRA é a atual (usada
# para gravar) e as demais só leem registros antigos. Gere cada chave com:
#   python manage.py gerar_chave
# Rotação: gere a chave nova, coloque-a na frente (2:<nova>,1:<antiga>), reinicie e
# rode "python manage.py recriptografar"; remova a antiga só depois disso.
# GUARDE as chaves fora do repositório e do banco: sem elas, os dados cifrados
# são irrecuperáveis. Perder a chave = perder os certificados cadastrados.
FREENFSE_CHAVES=

# --- Autenticação ---------------------------------------------------------------
# Não há cadastro público: só entra quem o Master cadastrou (e-mail/senha ou Google).
# O primeiro Master é criado pela linha de comando:
#   docker compose exec backend python manage.py createsuperuser

# Login com Google (OAuth). Deixe vazio para desativar. No console do Google, a URI
# de redirecionamento é  https://<seu-dominio>/accounts/google/login/callback/
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Microsoft e OpenID Connect genérico: instalados, mas DESLIGADOS por padrão.
# AUTH_MICROSOFT_ATIVO=false
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_TENANT=organizations
# AUTH_OIDC_ATIVO=false
# AUTH_OIDC_NOME=
# AUTH_OIDC_URL=
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=

# Restringe o login (inclusive o social) a estes domínios de e-mail, separados por
# vírgula. Vazio = qualquer domínio, desde que o e-mail esteja cadastrado.
# AUTH_DOMINIOS_PERMITIDOS=exemplo.com.br

# Verificação em duas etapas (TOTP). O Master a exige por padrão; para exigir de
# todos os usuários, ligue AUTH_EXIGIR_2FA_TODOS.
# AUTH_EXIGIR_2FA_MASTER=true
# AUTH_EXIGIR_2FA_TODOS=false

# Bloqueio por tentativas de login com falha: após N falhas para o mesmo e-mail, o
# login é recusado pelo número de segundos informado.
# AUTH_TENTATIVAS_MAXIMAS=5
# AUTH_BLOQUEIO_SEGUNDOS=900

# Minutos de inatividade até a sessão expirar (renovada a cada requisição).
# SESSAO_INATIVIDADE_MIN=30

# --- HTTPS e proxy ----------------------------------------------------------------
# Em produção, com HTTPS na borda, ligue as três opções abaixo.
# Cookies de sessão/CSRF só trafegam por HTTPS:
# COOKIES_SEGUROS=true
# O proxy que termina o TLS envia X-Forwarded-Proto; o Django passa a ver HTTPS:
# PROXY_TLS=true
# Origens (com esquema) autorizadas a enviar formulários, ex.: https://nfse.exemplo.com.br
# CSRF_TRUSTED_ORIGINS=
# Cabeçalho com o IP real do cliente (auditoria e bloqueio por IP). O Docker Compose
# já usa X-Real-IP, escrito pelo Nginx. Só configure se o backend NÃO for alcançável
# sem o proxy; do contrário qualquer cliente poderia forjar o IP.
# IP_CABECALHO_CONFIAVEL=X-Real-IP

# --- Download em lote (Fase 4) ---
# Pasta dos ZIPs temporários (compartilhada entre backend e worker; o Compose já monta o volume
# "exportacoes" em /var/lib/freenfse/exportacoes e define esta variável para os dois).
# FREENFSE_EXPORTACOES_DIR=/var/lib/freenfse/exportacoes
# Limites de um lote e quanto tempo o ZIP fica disponível.
# FREENFSE_LOTE_MAX_NOTAS=500
# FREENFSE_LOTE_MAX_MB=200
# FREENFSE_LOTE_RETENCAO_HORAS=24

# --- Agendamentos (Fase 5) ---
# Atraso máximo (em horas) com que uma data agendada ainda é executada se o sistema ficou fora do
# ar. Datas mais atrasadas viram aviso, não rascunho. Limitado a 23 h no código (padrão: 12).
# FREENFSE_AGENDAMENTO_TOLERANCIA_HORAS=12
